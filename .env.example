# Variáveis do ambiente de desenvolvimento.
#
# Para começar: rode `scripts/gerar-env.sh` (no Windows, pelo Git Bash). Ele copia este
# arquivo para .env trocando cada valor "troque" por uma senha aleatória e gera a chave
# do JWT. Nunca versione o .env.
#
# Mudou uma senha de banco depois da primeira subida? O script de inicialização só roda
# com o volume vazio: rode `docker compose down -v` para recriar o banco.

# ---------- PostgreSQL ----------
POSTGRES_DB=plataforma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque

# Dois usuários por módulo (Contrato §7.1): OWN aplica as migrations, APP roda a aplicação.
DB_OWN_IDENTITY_SENHA=troque
DB_APP_IDENTITY_SENHA=troque
DB_OWN_CRM_SENHA=troque
DB_APP_CRM_SENHA=troque
DB_OWN_PRODUTOS_SENHA=troque
DB_APP_PRODUTOS_SENHA=troque
DB_OWN_CONTRATOS_SENHA=troque
DB_APP_CONTRATOS_SENHA=troque
DB_OWN_FINANCEIRO_SENHA=troque
DB_APP_FINANCEIRO_SENHA=troque
DB_OWN_CHAMADOS_SENHA=troque
DB_APP_CHAMADOS_SENHA=troque
DB_OWN_MARKETING_SENHA=troque
DB_APP_MARKETING_SENHA=troque
DB_OWN_LANDING_SENHA=troque
DB_APP_LANDING_SENHA=troque
DB_OWN_EXEMPLO_SENHA=troque
DB_APP_EXEMPLO_SENHA=troque

# ---------- RabbitMQ ----------
RABBITMQ_VHOST=plataforma
RABBITMQ_ADMIN_USUARIO=admin
RABBITMQ_ADMIN_SENHA=troque

# Um usuário do broker por módulo (Contrato §13.3)
MQ_IDENTITY_SENHA=troque
MQ_CRM_SENHA=troque
MQ_PRODUTOS_SENHA=troque
MQ_CONTRATOS_SENHA=troque
MQ_FINANCEIRO_SENHA=troque
MQ_CHAMADOS_SENHA=troque
MQ_MARKETING_SENHA=troque
MQ_LANDING_SENHA=troque
MQ_EXEMPLO_SENHA=troque

# ---------- Token de serviço (Contrato §9.2) ----------
# clientSecret de cada módulo. O identity recebe todos; cada módulo recebe só o seu.
SVC_CRM_SEGREDO=troque
SVC_PRODUTOS_SEGREDO=troque
SVC_CONTRATOS_SEGREDO=troque
SVC_FINANCEIRO_SEGREDO=troque
SVC_CHAMADOS_SEGREDO=troque
SVC_MARKETING_SEGREDO=troque
SVC_LANDING_SEGREDO=troque
SVC_EXEMPLO_SEGREDO=troque

# ---------- Identity ----------
# Chave privada RS256 em PEM, codificada em base64 numa linha só. Gerada por scripts/gerar-env.sh.
IDENTITY_JWT_CHAVE_PRIVADA=
IDENTITY_JWT_KID=dev-2026
# "dev" cria os tenants e usuários de teste de docs/usuarios-de-teste.md
IDENTITY_PERFIL=dev
# Endereço público da plataforma, usado nos links de convite e de recuperação de senha
PLATAFORMA_URL=http://localhost:8080
# Primeiro administrador do tenant de produção: criado e convidado por e-mail só se o tenant
# ainda não tiver nenhum usuário. Vazio não faz nada.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_NOME=
# Pedido em identity.entrada sem user_id = mq_{moduloOrigem} vai para a .dlq (Contrato §9.7).
# "false" só em emergência, enquanto um módulo corrige o publicador.
IDENTITY_EXIGIR_USER_ID=true

# ---------- Gateway ----------
# Origens liberadas para CORS, para fronts rodando fora do gateway em desenvolvimento
# (Requisito RF46). Vazio desliga o CORS — em produção tudo tem a mesma origem.
CORS_ORIGENS=http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3090,http://localhost:5173
# Requisições por minuto, por IP, nas rotas /public/** (Requisito RF45). 0 desliga.
LIMITE_PUBLICO_POR_MINUTO=120

# ---------- Log ----------
# Formato do log dos serviços Spring: ecs (JSON, padrão), logstash ou gelf. Para ler no
# terminal durante o desenvolvimento, "docker compose logs identity | jq -r .message".
LOG_FORMATO=ecs

# ---------- Imagens ----------
# Plataforma (Grupo 2). O nome da conta vai em minúsculas.
IMAGEM_IDENTITY=ghcr.io/karolalbuquerque/identity:latest
IMAGEM_GATEWAY=ghcr.io/karolalbuquerque/gateway:latest
IMAGEM_CASCA=ghcr.io/karolalbuquerque/casca:latest

# Módulos: cada grupo troca CONTA-DO-GRUPO pela conta onde publica as imagens.
IMAGEM_CRM=ghcr.io/conta-do-grupo/crm:latest
IMAGEM_CRM_FRONT=ghcr.io/conta-do-grupo/crm-front:latest
IMAGEM_PRODUTOS=ghcr.io/conta-do-grupo/produtos:latest
IMAGEM_PRODUTOS_FRONT=ghcr.io/conta-do-grupo/produtos-front:latest
IMAGEM_CONTRATOS=ghcr.io/conta-do-grupo/contratos:latest
IMAGEM_CONTRATOS_FRONT=ghcr.io/conta-do-grupo/contratos-front:latest
IMAGEM_FINANCEIRO=ghcr.io/conta-do-grupo/financeiro:latest
IMAGEM_FINANCEIRO_FRONT=ghcr.io/conta-do-grupo/financeiro-front:latest
IMAGEM_CHAMADOS=ghcr.io/conta-do-grupo/chamados:latest
IMAGEM_CHAMADOS_FRONT=ghcr.io/conta-do-grupo/chamados-front:latest
IMAGEM_MARKETING=ghcr.io/conta-do-grupo/marketing:latest
IMAGEM_MARKETING_FRONT=ghcr.io/conta-do-grupo/marketing-front:latest
IMAGEM_LANDING=ghcr.io/conta-do-grupo/landing:latest
IMAGEM_LANDING_FRONT=ghcr.io/conta-do-grupo/landing-front:latest
